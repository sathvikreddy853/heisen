// TokenType.def
#ifndef TOK
#define TOK(X)
#endif

#ifndef KEYWORD
#define KEYWORD(X, Y) TOK(X)
#endif

KEYWORD(Int,        "int")
KEYWORD(Float,      "float")
KEYWORD(Bool,       "bool")
KEYWORD(String,     "string")
KEYWORD(Bit,        "bit")
KEYWORD(Qubit,      "qubit")
KEYWORD(Cast,       "cast")
KEYWORD(And,        "and")
KEYWORD(Or,         "or")
KEYWORD(Not,        "not")
KEYWORD(Try,        "try")
KEYWORD(Throw,      "throw")
KEYWORD(Catch,      "catch")
KEYWORD(Let,        "let")
KEYWORD(Const,      "const")
KEYWORD(Break,      "break")
KEYWORD(Continue,   "continue")
KEYWORD(Generic,    "generic")
KEYWORD(Struct,     "struct")
KEYWORD(Scope,      "scope")
KEYWORD(If,         "if")
KEYWORD(Elif,       "elif")
KEYWORD(Else,       "else")
KEYWORD(Match,      "match")
KEYWORD(With,       "with")
KEYWORD(True,       "true")
KEYWORD(False,      "false")
KEYWORD(For,        "for")
KEYWORD(While,      "while")
KEYWORD(Func,       "func")
KEYWORD(Return,     "return")
KEYWORD(Gate,       "gate")
KEYWORD(Circuit,    "circuit")
KEYWORD(Measure,    "measure")
KEYWORD(Reset,      "reset")
