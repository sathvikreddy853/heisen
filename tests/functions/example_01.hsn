"""
    FILE: example_01.hsn
    BRIEF: This file has been created to test basic function calls for quantum structures  
"""

func create_bell_state (q: qubit[2]) {
    CNOT @ [H, I] @ q
}

func restore_original (q: qubit[2]) {
    CNOT @ q
    H @ q[0]
}

let q: qubit[2]
create_bell_state(q)
restore_original(q)