}

func test_return_errors() : int {
    return 3.14;
}

func test_void_return() {
    return 10;
}

func test_quantum_safety() {
    let q: qubit[2];
    let q2: qubit[2];
    
    let res: int = q[0] + q[1];
    if (q[0] == q[1]) {
        print("Error");
    }

    let i: int = 0;
    let b: bit;
    measure i => b;

    H @ i;
    RX(1.0, 2.0) @ q[0];
}

func test_function_calls() {
    test_return_errors(1);

    let s: float = sqrt(10); 
    let s2: float = sqrt(true); 

    let x: int = 10;
    x();
}

func test_arrays() {
