# Test Case: All Semantic Errors
# Note: The compiler stops at the first error.

func test_type_mismatches() {
    let i: int = 10;
    let f: float = 3.14;
    let b: bool = true;

    let i2: int = 3.14; 
    let b2: bool = 10;
    let res1: int = 1 + true;

    if (true < 10) { print("Error"); }
    let res3: int = -true;
}

