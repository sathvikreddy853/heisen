func add (A: int[][], B: int[][]) : int[][] {
    let m, n = A.shape;
    let p, q = B.shape;

    if (m != p || n != q) {
        panic("Matrices must have the same dimensions");
    }

    let C: int[m][n];
    for (i: int = 0; i < m; i += 1) {
        for (j: int = 0; j < n; j += 1) {
            C[i][j] = A[i][j] + B[i][j];
        }
    }

    return C;
}

let A: int[2][2] = [[1, 2], [3, 4]];
let B: int[2][2] = [[5, 6], [7, 8]];
let C: int[2][2] = add(A, B);
print(C);   
