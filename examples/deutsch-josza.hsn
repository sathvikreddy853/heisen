func deutsch_josza (n: int, Uf: ((qubit[], qubit) => ())) : bit {
    let res: bit[n];
    let x: qubit[n];
    let y: qubit;

    H(n) @ x;
    H @ X @ y;

    Uf(x, y);

    H(n) @ x;

    measure x => res;

    for (i: int = 0; i < n; i += 1) {
        if (res[i] == 1) {
            return 1;
        }
    }

    return 0;
}

func create_oracle (s: bit[]) : ((qubit[], qubit) => ()) {
    return (x: qubit[], y: qubit) {
        let n: int = s.size;

        for (i: int = 0; i < n; i += 1) {
            if (s[i] == 1) {
                CNOT @ [x[i], y];
            }
        }
    };
}


let s: bit[4] = [1, 0, 1, 1];
let Uf: ((qubit[], qubit) => ()) = create_oracle(s);

let b: bit = deutsch_josza(4, Uf);

if (b == 0) {
    println("Constant Function");
} else {
    println("FAILED");
}
