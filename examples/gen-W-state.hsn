func generate_W_state_range(q: qubit[], start: int, end: int) {
    let n: int = end - start;

    if (n == 1) {
        X @ q[start];
    } else {
        let k: int = n/2;

        generate_W_state_range(q, start, start + k);

        let anc: qubit;
        H @ anc;

        for (i: int = 0; i < k; i += 1) {
            CSWAP @ [anc, q[start + i], q[start + k + i]];
        }

        for (i: int = 0; i < n - k; i += 1) {
            CNOT @ [q[start + k + i], anc];
        }
    }
}
