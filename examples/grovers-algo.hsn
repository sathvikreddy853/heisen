# Heisen: generic n-qubit Grover (no nested functions, C-style for loops)

# helper: oracle that flips phase of |target> by mapping target -> |11..1>,
# applying [CTRL(n), Z] @ q, then undoing the mapping.
func apply_oracle(n: int, q: qubit[n], target: int) {
    # flip qubits where target bit == 0
    for (int i = 0; i < n; i = i + 1) {
        if (((target >> i) & 1) == 0) {
            X @ q[i]
        }
    }

    # n-controlled Z (phase flip on |11..1>)
    [CTRL(n), Z] @ q

    # undo the flips
    for (int i = 0; i < n; i = i + 1) {
        if (((target >> i) & 1) == 0) {
            X @ q[i]
        }
    }

    return
}

# helper: diffusion (inversion about the mean)
func diffusion(n: int, q: qubit[n]) {
    H(n) @ q
    for (i: int = 0; i < n; i += 1) {
        X @ q[i]
    }

    [CTRL(n), Z] @ q

    for (i: int = 0; i < n; i += 1) {
        X @ q[i]
    }

    H(n) @ q
    return
}

# main Grover routine
# - n: number of qubits
# - target: integer index of marked basis state; if target < 0 treat as default |11..1|
func n_qubit_grover(n: int, target: int = (1 << n) - 1) {
    let q: qubit[n]
    let b: bit[n]

    # create uniform superposition
    H(n) @ q

    # number of iterations: r = floor(pi/4 * sqrt(2^n))
    let N = 1 << n
    let r = floor((pi / 4.0) * sqrt(float(N)))

    # Grover iterate r times
    for (i: int = 0; i < r; i += 1) {
        apply_oracle(n, q, target)
        diffusion(n, q)
    }

    # measure
    measure q => b

    print("Measured:")
    for (int i = n - 1; i >= 0; i = i - 1) {
        print("b[i]: {b[i]}, ")
    }
    println()

    return b       
}

n_qubit_grover(3, target = 5)